name = "Deinterlace Bob"
category = "Deinterlacing"
code = """
# Simple bob deinterlacing (field separation)
# Full Docs: https://www.vapoursynth.com/doc/functions/video/separatefields.html

from vstools import vs, core

tff = True  # Top field first

# Separate fields and double frame rate
clip = core.std.SeparateFields(clip, tff=tff)"""
description = "Bob deinterlacing - separates fields to double frame rate"

