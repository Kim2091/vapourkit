name = "Duplicate Aware Filter"
category = ["Hybrid", "Optimization"]
code = """
# Apply filters only to unique frames
# From hybrid_filters/duplicate_aware.py
import sys
sys.path.insert(0, r'hybrid_filters')
from duplicate_aware import duplicateAware

# Define your filter function
def my_filter(clip):
    return clip.std.Convolution(matrix=[1, 2, 1, 2, 4, 2, 1, 2, 1])

clip = duplicateAware(clip, filter_func=my_filter, thresh=0.001, debug=False)"""
description = "Processes only unique frames with custom filter, duplicates results for efficiency"

