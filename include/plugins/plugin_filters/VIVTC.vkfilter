name = "VIVTC"
category = ["Deinterlacing", "Telecine"]
code = """
# Inverse telecine (30i to 24p conversion)
# Full Docs: https://github.com/vapoursynth/vivtc

order = 1  # Field order (0=bottom first, 1=top first)

# VFM and VDecimate measure on 8-bit pictures, so they match on an 8-bit
# copy and output the full-quality clip (clip2): nothing is lost to the
# measuring. original_clip is left alone, so a later step reading "the
# source" still gets the source.
_match = core.resize.Bicubic(clip, format=vs.YUV420P8) if clip.format.id != vs.YUV420P8 else clip
_matched = core.vivtc.VFM(_match, order=order, clip2=clip)
clip = core.vivtc.VDecimate(core.vivtc.VFM(_match, order=order), clip2=_matched)"""
description = "Inverse telecine to convert 30i/60i back to original 24p film. If some frames stay combed, IVTC (AI Fallback) replaces just those."

[metadata]
createdAt = "2026-01-31T00:00:00.000Z"
