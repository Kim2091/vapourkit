name = "Merge Clips"
category = "Utility"
code = """
# Merge two clips using a mask
# Full Docs: https://www.vapoursynth.com/doc/functions/video/merge.html

clip_a = clip
clip_b = clip  # Replace with your second clip
# mask = your_mask_clip  # Replace with your mask

# For demonstration, merge clip with itself using luma as mask
clip = core.std.MaskedMerge(clip_a, clip_b, clip)"""
description = "Merges two clips together using a mask (white areas show first clip)"

