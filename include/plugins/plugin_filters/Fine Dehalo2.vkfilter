name = "Fine Dehalo2"
category = "Restoration"
code = """
# Full Docs: https://jaded-encoding-thaumaturgy.github.io/vs-dehalo/
# Halo removal function for 2nd order halos
# mode is now a ConvMode: HORIZONTAL, VERTICAL, or HV (both)
# brightstr/darkstr independently control bright/dark halo strength now;
# the old tri-state "dark" switch was folded into those two and no longer exists.

import vsdehalo
from vstools import ConvMode
clip = vsdehalo.fine_dehalo2(clip, mode=ConvMode.HV, radius=2, mask_radius=2, brightstr=1.0, darkstr=1.0)"""
description = "Removes 2nd order halos (both bright and dark) from the clip."

[metadata]
createdAt = "2025-01-11T00:00:00.000Z"
