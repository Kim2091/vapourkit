name = "Chroma Shift"
category = ["Hybrid", "Chroma"]
code = """
# Shift chroma planes horizontally and vertically
# From hybrid_filters/chromashift.py
import sys
sys.path.insert(0, r'hybrid_filters')
from chromashift import ChromaShift

clip = ChromaShift(clip, shift_left=0, shift_right=0, shift_top=0, shift_bottom=0)"""
description = "Shifts chroma planes to correct chroma misalignment"

