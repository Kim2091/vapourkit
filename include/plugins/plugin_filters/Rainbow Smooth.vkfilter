name = "Rainbow Smooth"
category = ["Hybrid", "Chroma"]
code = """
# Remove rainbow artifacts with edge-aware smoothing
# From hybrid_filters/RainbowSmooth.py
import sys
sys.path.insert(0, r'hybrid_filters')

# RainbowSmooth.py unconditionally does `import mvsfunc as mvf`, but the
# bundled mvsfunc.py is broken: it was written to live inside a package
# (`from ._metadata import __version__`) and the vs-scripts download flattens
# every script into one directory, so that relative import fails even though
# mvsfunc isn't actually needed for the default mask="original" path here.
# mvsfunc also isn't on PyPI. Provide a minimal stand-in exposing the one
# function (Depth) RainbowSmooth.py calls from it.
import types as _pytypes
if 'mvsfunc' not in sys.modules:
    from vstools import depth as _depth
    _mvf = _pytypes.ModuleType('mvsfunc')
    _mvf.Depth = _depth
    sys.modules['mvsfunc'] = _mvf

from RainbowSmooth import RainbowSmooth

clip = RainbowSmooth(clip, radius=3, lthresh=0, hthresh=220, mask="original")"""
description = "Removes rainbow artifacts using edge-aware chroma smoothing"

