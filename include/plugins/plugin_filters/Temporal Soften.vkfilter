name = "Temporal Soften"
category = "Temporal Smoothing"
code = """
# Soften temporally (motion-adaptive smoothing)
# Full Docs: https://www.vapoursynth.com/doc/functions/video/temporalsoften.html

from vstools import vs, core

radius = 2  # Temporal radius
luma_threshold = 4  # Luma difference threshold
chroma_threshold = 8  # Chroma difference threshold
scenechange = 15  # Scene change threshold (0-254)

clip = core.std.TemporalSoften(clip, radius=radius, luma_threshold=luma_threshold, 
                                chroma_threshold=chroma_threshold, scenechange=scenechange)"""
description = "Motion-adaptive temporal smoothing to reduce noise and flickering"

[metadata]
createdAt = "2026-01-31T00:00:00.000Z"
