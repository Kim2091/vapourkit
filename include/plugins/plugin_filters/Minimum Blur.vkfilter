name = "Minimum Blur"
category = "Blurring"
code = """
# Full Docs: https://jaded-encoding-thaumaturgy.github.io/vs-jetpack/api/vsrgtools/blur/

from vsrgtools import min_blur

# Apply minimum blur (combination of binomial and median blur)
radius = 1
clip = min_blur(clip, radius=radius)"""
description = "Applies minimum blur - selects the minimum blur between binomial and median blur"

