name = "Rekt"
category = ["Hybrid", "Masking"]
code = """
# Apply fixes to rectangular regions
# From hybrid_filters/rekt.py
import sys
sys.path.insert(0, r'hybrid_filters')
from rekt import rekt

# Apply a fix to a specific region
fix = clip.std.Convolution(matrix=[1, 2, 1, 2, 4, 2, 1, 2, 1])
clip = rekt(clip, fix, left=10, top=10, right=10, bottom=10)"""
description = "Creates rectangular mask for applying fixes to specific regions"

