name = "Replace Black Frames"
category = ["Hybrid", "Frame Recovery"]
code = """
# Replace black frames with interpolation or previous frame
# From hybrid_filters/ReplaceBlackFrames.py
import sys
sys.path.insert(0, r'hybrid_filters')
from ReplaceBlackFrames import ReplaceBlackFrames

rbf = ReplaceBlackFrames(clip, thresh=0.1, method='previous', debug=False)
clip = rbf.out"""
description = "Detects and replaces black frames with interpolated or previous frames"

