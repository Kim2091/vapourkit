name = "Reduce Flicker"
category = "Temporal Smoothing"
code = """
# Reduce temporal flicker using vsrgtools
# Full Docs: https://jaded-encoding-thaumaturgy.github.io/vs-jetpack/api/vsrgtools/

from vstools import vs, core
from vsrgtools import contrasharpening_median

strength = 192  # Strength of flicker reduction (0-255)

clip = core.flux.SmoothT(clip, temporal_threshold=strength)"""
description = "Reduces temporal flicker and noise while preserving detail"

