name = "Chroma Resample"
category = "Color Space"
code = """
# Change chroma subsampling (4:2:0 to 4:4:4 etc.)

from vstools import vs, core

# Target format
format_out = vs.YUV444P16  # YUV444P16 (4:4:4), YUV422P16 (4:2:2), YUV420P16 (4:2:0)

clip = core.resize.Spline36(clip, format=format_out)"""
description = "Changes chroma subsampling format (4:2:0, 4:2:2, 4:4:4)"

[metadata]
createdAt = "2026-01-31T00:00:00.000Z"
