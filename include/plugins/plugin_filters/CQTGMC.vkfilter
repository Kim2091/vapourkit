name = "CQTGMC"
category = ["Hybrid", "Deinterlacing"]
code = """
# Fast deinterlacing with QTGMC-like quality
# From hybrid_filters/cqtgmc.py
import sys
sys.path.insert(0, r'hybrid_filters')
