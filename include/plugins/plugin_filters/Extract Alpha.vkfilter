name = "Extract Alpha"
category = "Utility"
code = """
# Extract alpha channel as grayscale

from vstools import vs, core

# Extract alpha plane
clip = core.std.ShufflePlanes(clip, planes=3, colorfamily=vs.GRAY)"""
