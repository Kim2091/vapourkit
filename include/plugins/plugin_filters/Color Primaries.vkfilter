name = "Color Primaries"
category = "Color Space"
code = """
# Convert between color primaries (BT.709/BT.2020/DCI-P3)

from vstools import vs, core

primaries_in = "709"  # Input: 709, 170m, 240m, 2020, dci-p3, display-p3
primaries_out = "709"  # Output

clip = core.resize.Bicubic(clip, primaries_in_s=primaries_in, primaries_s=primaries_out)"""
description = "Converts between different color primaries (Rec.709/2020, DCI-P3 etc.)"

