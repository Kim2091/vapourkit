{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vapourkit",
  "version": "0.14.1",
  "identifier": "com.aivideoupscaler.gui",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vapourkit",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../include/models/**/*.onnx": "models",
      "../include/plugins/**/*.7z": "plugins",
      "../include/plugins/plugin_filters/**/*": "plugins/plugin_filters",
      "../include/scripts/**/*.7z": "scripts",
      "../include/filter_templates/**/*.vkfilter": "filter_templates",
      "../include/vapoursynth_template.vpy": ".",
      "../include/stock-app-config.json": "."
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
